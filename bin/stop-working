#!/bin/bash
# Signal /work-all-tickets to stop after its current ticket finishes.
# Run from anywhere inside a git repo.

root=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$root" ]; then
  echo "Not inside a git repository." >&2
  exit 1
fi

touch "$root/.stop-working"
echo "Stop signal created. /work-all-tickets will stop after the current ticket."
