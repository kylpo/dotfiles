{
  "permissions": {
    "allow": [
      "Bash(grep:*)",
      "Bash(xcodebuild:*)",
      "Bash(ls:*)",
      "WebSearch",
      "Bash(swift test:*)",
      "Bash(swift build:*)",
      "Bash(xcrun momc:*)",
      "Bash(echo exit: $?:*)",
      "Bash(xcrun simctl:*)",
      "Bash(xcodebuild build:*)",
      "Bash(xcodebuild build-for-testing:*)",
      "Bash(mv:*)",
      "Bash(swift:*)",
      "Bash(wc:*)",
      "Bash(echo EXIT: $?:*)",
      "Bash(chmod +x:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(~/.claude/skills/**)",
      "Read(~/github/skills/**)",
      "Read(~/.claude/**)",
      "Skill",
      "Bash(cd /tmp/worktree-*)",
      "Read(//tmp/worktree-*/**)",
      "Write(//tmp/worktree-*/**)",
      "Edit(//tmp/worktree-*/**)",
      "Bash(/Users/kylpo/.claude/skills/**)",
      "Bash(/Users/kylpo/.claude/scripts/**)",
      "Read(//Users/kylpo/github/skills/**)",
      "Bash(build)",
      "Bash(build:*)",
      "Bash(check)",
      "Bash(check:*)",
      "Bash(code-test)",
      "Bash(code-test:*)",
      "Bash(coverage)",
      "Bash(coverage:*)",
      "Bash(install)",
      "Bash(install:*)",
      "Bash(lint)",
      "Bash(lint:*)",
      "Bash(logs)",
      "Bash(logs:*)",
      "Bash(pbxproj)",
      "Bash(pbxproj:*)",
      "Bash(run)",
      "Bash(run:*)",
      "Bash(ui-test)",
      "Bash(ui-test:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)"
    ],
    "defaultMode": "default"
  },
  "model": "opus[1m]",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "printf '{\"ppid\":%s,\"event\":%s}\\n' \"$PPID\" \"$(cat)\" | nc -U ~/Library/Containers/com.cronstruct.MAIFocus/Data/server.sock"
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "printf '{\"ppid\":%s,\"event\":%s}\\n' \"$PPID\" \"$(cat)\" | nc -U ~/Library/Containers/com.cronstruct.MAIFocus/Data/server.sock"
          }
        ]
      },
      {
        "matcher": "auth_success",
        "hooks": [
          {
            "type": "command",
            "command": "printf '{\"ppid\":%s,\"event\":%s}\\n' \"$PPID\" \"$(cat)\" | nc -U ~/Library/Containers/com.cronstruct.MAIFocus/Data/server.sock"
          }
        ]
      },
      {
        "matcher": "elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "printf '{\"ppid\":%s,\"event\":%s}\\n' \"$PPID\" \"$(cat)\" | nc -U ~/Library/Containers/com.cronstruct.MAIFocus/Data/server.sock"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '{\"ppid\":%s,\"event\":%s}\\n' \"$PPID\" \"$(cat)\" | nc -U ~/Library/Containers/com.cronstruct.MAIFocus/Data/server.sock"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '{\"ppid\":%s,\"event\":%s}\\n' \"$PPID\" \"$(cat)\" | nc -U ~/Library/Containers/com.cronstruct.MAIFocus/Data/server.sock"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '{\"ppid\":%s,\"event\":%s}\\n' \"$PPID\" \"$(cat)\" | nc -U ~/Library/Containers/com.cronstruct.MAIFocus/Data/server.sock"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '{\"ppid\":%s,\"event\":%s}\\n' \"$PPID\" \"$(cat)\" | nc -U ~/Library/Containers/com.cronstruct.MAIFocus/Data/server.sock"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '{\"ppid\":%s,\"event\":%s}\\n' \"$PPID\" \"$(cat)\" | nc -U ~/Library/Containers/com.cronstruct.MAIFocus/Data/server.sock"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '{\"ppid\":%s,\"event\":%s}\\n' \"$PPID\" \"$(cat)\" | nc -U ~/Library/Containers/com.cronstruct.MAIFocus/Data/server.sock"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '{\"ppid\":%s,\"event\":%s}\\n' \"$PPID\" \"$(cat)\" | nc -U ~/Library/Containers/com.cronstruct.MAIFocus/Data/server.sock"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/skill-md-gate.sh write"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/skill-md-gate.sh edit"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // empty'); if printf '%s' \"$cmd\" | grep -Eq '(^|[[:space:];&|`$()])rm([[:space:];&|]|$)'; then printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Use `trash` instead of `rm` (sends to macOS Trash, recoverable). Note: `trash` only takes file paths — drop -rf and similar flags.\"}}'; fi"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "path=$(jq -r '.tool_input.file_path // empty'); if printf '%s' \"$path\" | grep -Eq '\\.pbxproj$'; then printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Do not read project.pbxproj directly - it is huge and wastes context. Use `pbxproj` instead (on $PATH via ~/github/tools). Run `pbxproj --help` for subcommands: targets, files, add-file, remove-file, build-settings, set-build-setting.\"}}'; fi"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // empty'); if printf '%s' \"$cmd\" | grep -Eq '(^|;|&&|\\|\\|)[[:space:]]*(cat|head|tail)([[:space:]]|$)' && ! printf '%s' \"$cmd\" | grep -Eq '(<<|>|(^|;|&&|\\|\\|)[[:space:]]*(cat|head|tail)[^|;]*\\|)'; then printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Use the Read tool instead of cat/head/tail. The Bash tool is reserved for shell-only operations. To filter output of another command, pipe into head/tail/sed/awk after a single | — that case is allowed.\"}}'; fi"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // empty'); if printf '%s' \"$cmd\" | grep -Eq '(^|[^a-zA-Z0-9_/.-])\\.levers\\.yml([^a-zA-Z0-9_/.-]|$)' && ! printf '%s' \"$cmd\" | grep -qE '(^|[[:space:]])levers[[:space:]]+(get|merge-strictest|validate|audit|set|init|detect-packages|list-enums)'; then printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Use `levers get [<key>] --at <path>` (omit the key for the full merged view) to read the effective value. Reading .levers.yml directly skips inheritance resolution between root and package files.\"}}'; fi"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "path=$(jq -r '.tool_input.file_path // empty'); if printf '%s' \"$path\" | grep -Eq '(^|/)\\.levers\\.yml$'; then printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Use `levers get [<key>] --at <path>` (omit the key for the full merged view) to read the effective value. Reading .levers.yml directly skips inheritance resolution between root and package files.\"}}'; fi"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // empty'); cmd=$(printf '%s' \"$cmd\" | sed -E 's/:(!|\\(exclude\\))[^[:space:]]*//g'); if printf '%s' \"$cmd\" | grep -q '\\.pbxproj'; then printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Do not access project.pbxproj directly via shell — it is huge and wastes context. Use `pbxproj` instead (on $PATH via ~/github/tools). Run `pbxproj --help` for subcommands: targets, files, add-file, remove-file, build-settings, set-build-setting.\"}}'; fi"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "path=$(jq -r '.tool_input.file_path // empty'); if printf '%s' \"$path\" | grep -Eq '/\\.blaster-(plan\\.md|metadata\\.json)$'; then printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"This file is script-owned. To change the plan, edit .blaster-analysis.md and re-run ~/.claude/skills/blaster/scripts/build-plan.sh. To change metadata, re-run ~/.claude/skills/blaster/scripts/orient.sh (mid-pipeline package discovery / lever re-resolution) or bin/blaster-setup.sh (ticket fields).\"}}'; fi"
          }
        ]
      }
    ],
